# The Windows system launcher reads backend/.env; copy this file there and edit it.
# Existing process environment variables take precedence over this file.
# Docker/fresh database:
CANONICAL_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests
# Existing portable database on this Windows workspace (backend/.cache/canonical-runtime,
# port 55433): this single Postgres instance hosts several databases -- verify the name
# printed by `npm run system:status` / `/api/ready` before trusting this default, and see
# docs/architecture/CANONICAL_DATABASE_RUNTIME.md. As of 2026-09-11 the operational EO
# database (real AOIs, EO cohorts/jobs/observations) is ea_forests_uganda_country_pass;
# ea_forests_import is an entity/geometry import-staging snapshot with zero AOIs -- do not
# assume it is current just because it is named after this project.
# CANONICAL_DATABASE_URL=postgresql+psycopg://ea_forests@127.0.0.1:55433/ea_forests_uganda_country_pass
CANONICAL_ARTIFACT_ROOT=.cache/canonical-artifacts
# Canonical routes are NOT disabled when this is blank: system:start then generates a
# private, process-only admin token and the browser gets a short-lived HttpOnly session via
# POST /api/canonical/session/bootstrap (see GET /api/canonical/session/status). Leave this
# blank for normal local development; only set it for a non-interactive/CI caller that needs
# a static token. Never commit a real value here, and never expose it to frontend JavaScript
# (no VITE_CANONICAL_API_TOKEN).
CANONICAL_API_TOKEN=
# Optional: use your registered Earth Engine / Google Cloud project.
EARTH_ENGINE_PROJECT=
# Tests require a separate disposable database, never your operational database.
CANONICAL_TEST_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests_test
