CANONICAL_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests
# The public "Latest EO" landing card (GET /api/eo/public/country-status, no auth) reads from this
# same database once it has migrations 0003-0012 applied (geo.aoi/aoi_version, observations.eo_*).
# In this workspace, a portable Postgres instance with real Uganda/Tanzania EO observations already
# migrated is available at postgresql+psycopg://ea_forests@127.0.0.1:55433/ea_forests_uganda_country_pass
# (see C:/Users/JasonOyugi/Downloads/EA-Forests/backend/.cache/canonical-runtime) — point
# CANONICAL_DATABASE_URL there for local dev instead of a fresh empty database.
CANONICAL_ARTIFACT_ROOT=.cache/canonical-artifacts
# Canonical routes are disabled unless this local administrative token is configured.
# Generate your own token; do not expose the canonical database directly to a public network.
CANONICAL_API_TOKEN=
# Tests require a separate disposable database, never your operational database.
CANONICAL_TEST_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests_test
