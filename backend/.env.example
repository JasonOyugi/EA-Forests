# The Windows system launcher reads backend/.env; copy this file there and edit it.
# Existing process environment variables take precedence over this file.
# Docker/fresh database:
CANONICAL_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests
# Existing portable database on this Windows workspace:
# CANONICAL_DATABASE_URL=postgresql+psycopg://ea_forests@127.0.0.1:55433/ea_forests_import
CANONICAL_ARTIFACT_ROOT=.cache/canonical-artifacts
# Canonical routes are disabled unless this local administrative token is configured.
# Generate your own token; do not expose the canonical database directly to a public network.
CANONICAL_API_TOKEN=
# system:start generates a private process-only token when this is blank.
# Optional: use your registered Earth Engine / Google Cloud project.
EARTH_ENGINE_PROJECT=
# Tests require a separate disposable database, never your operational database.
CANONICAL_TEST_DATABASE_URL=postgresql+psycopg://ea_forests:local-development-only@127.0.0.1:5433/ea_forests_test
